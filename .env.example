# Copier ce fichier en .env.local (jamais commité) et renseigner les identifiants
# du compte data.grandlyon.com. Laisser vide pour lancer l'appli en mode démo.
# Ces variables ne commencent pas par VITE_ : elles restent côté serveur de dev
# et ne sont jamais envoyées au navigateur.
GRANDLYON_USER=
GRANDLYON_PASSWORD=

# Adresse du relais appelé par le front (par défaut le relais du serveur de dev).
# VITE_TCL_API_URL=/api/grandlyon
